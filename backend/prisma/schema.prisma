generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  picture   String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  color     String?
  expense   Expense[]  
  createdAt DateTime  @default(now())
}

model Expense {
  id         String    @id @default(cuid())
  amount     Float
  merchant   String
  note       String?
  date       DateTime
  userId     String
  categoryId String
  user       User      @relation(fields: [userId], references: [id])
  category   Category  @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

